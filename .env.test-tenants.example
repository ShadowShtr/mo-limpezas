# Copia para .env.test-tenants.local e preenche os valores.
# .env.test-tenants.local NUNCA deve ir para o Git (coberto por .env* no
# .gitignore) — só este ficheiro de exemplo, sem valores, é versionado.
#
# Usado por scripts/test-tenants/{provision,verify-isolation,cleanup}.mjs
# para criar e testar dois tenants isolados no MESMO projeto Supabase de
# produção usado pela app real (não um projeto de staging separado).

# Mesmo projeto Supabase da app (produção) — provision.mjs e cleanup.mjs
# usam SUPABASE_SERVICE_ROLE_KEY (bypassa RLS, só para provisionar/remover
# os objetos de teste). verify-isolation.mjs usa exclusivamente
# SUPABASE_ANON_KEY, para provar RLS com sessões reais autenticadas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Tenant A — MO Testes Atomicidade (slug: mo-testes-atomicidade)
TEST_A_ADMIN_EMAIL=
TEST_A_ADMIN_PASSWORD=

TEST_A_MANAGER_EMAIL=
TEST_A_MANAGER_PASSWORD=

TEST_A_COLLABORATOR_EMAIL=
TEST_A_COLLABORATOR_PASSWORD=

# Tenant B — Teste Isolamento Tenant (slug: teste-isolamento-tenant)
TEST_B_ADMIN_EMAIL=
TEST_B_ADMIN_PASSWORD=
